<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>query-field-testfixtures</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>query-field-testfixtures</name>
  <description>Implementation-neutral fixtures, an in-memory reference FieldSource/ConceptSource, and the reusable contract test kit any query-field implementation validates itself against. See docs/specs/field-contract.md.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <sequeless.github.repository>sequeless-query</sequeless.github.repository>
    <flatten.version>1.9.0</flatten.version>
    <kernel-identity.version>0.1.1</kernel-identity.version>
    <junit-jupiter.version>5.14.4</junit-jupiter.version>
    <assertj-core.version>3.27.7</assertj-core.version>

    <!-- Published test support: the kit and the in-memory source are released with query-field. -->
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-field</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <version>${kernel-identity.version}</version>
    </dependency>
    <!-- Kit and in-memory source live in src/main, so other modules can use them as published test support. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>compile</scope>
    </dependency>
    <!-- The main sources import the JUnit API directly; it was only reachable transitively before. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The boundary test imports these directly, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Declared here, as sequeless-filter does, so Maven can fetch the sequeless-build-parent POM itself. -->
  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <!-- junit-jupiter aggregates the engine that this module's own tests run on; no class is referenced from it directly, so dependency:analyze-only reports it unused. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUnusedDeclaredDependencies>
            <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
          </ignoredUnusedDeclaredDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
