<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>query-field</artifactId>
  <version>0.1.1</version>
  <packaging>jar</packaging>

  <name>query-field</name>
  <description>Field contract: what the Query side can filter, facet, search and sort</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <sequeless.github.repository>sequeless-query</sequeless.github.repository>
    <flatten.version>1.9.0</flatten.version>
    <kernel-identity.version>0.1.1</kernel-identity.version>
    <junit-jupiter.version>5.14.4</junit-jupiter.version>
    <assertj-core.version>3.27.7</assertj-core.version>

    <!-- Published: the Field contract is a released artifact. -->
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- Kernel-identity is the only compile dependency this contract allows. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <version>${kernel-identity.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import these directly, so they stay declared, or dependency:analyze reports them as used undeclared. Each already resolved transitively at the same version. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Declared here, as sequeless-filter does, so Maven can fetch the sequeless-build-parent POM itself. -->
  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-all-runtime-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                  </excludes>
                  <!-- Kernel-identity is the one permitted compile and runtime dependency. -->
                  <includes>
                    <include>org.sequeless:kernel-identity:*:*:compile</include>
                    <include>org.sequeless:kernel-identity:*:*:runtime</include>
                  </includes>
                  <message>query-field is the Field contract; every consumer inherits whatever it declares. Its only compile or runtime dependency may be org.sequeless:kernel-identity.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
