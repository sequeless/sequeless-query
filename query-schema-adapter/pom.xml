<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent. Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>query-schema-adapter</artifactId>
  <version>0.2.3</version>
  <name>query-schema-adapter</name>
  <description>Schema to Field adapter: builds Fields from the schema contract</description>

  <properties>
    <!-- The deploy URL is built from this name; it must name this repository (the parent defaults to sequeless-build). -->
    <sequeless.github.repository>sequeless-query</sequeless.github.repository>
    <!-- Matches query-field: this module reads query-field classes compiled for 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Opts in to the parent's enforcer ban on Spring, Jena and Lombok. -->
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <!-- Published: the adapter is released with the query side. -->
    <maven.deploy.skip>false</maven.deploy.skip>
    <schema-contract.version>0.2.0</schema-contract.version>
    <kernel-identity.version>0.1.1</kernel-identity.version>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Compile dependencies: the Field contract this adapter implements, the Schema it reads, and the tenant identity. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-field</artifactId>
      <version>0.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
      <version>${schema-contract.version}</version>
      <exclusions>
        <!-- schema-contract 0.2.0 also pins kernel-identity 0.1.1. The exclusion keeps this module's declared version authoritative if schema-contract moves ahead. -->
        <exclusion>
          <groupId>org.sequeless</groupId>
          <artifactId>kernel-identity</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <version>${kernel-identity.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import these directly, so they stay declared, or dependency:analyze reports them as used undeclared. Versions come from the junit-bom import. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The test imports archunit and archunit-junit5-api, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
